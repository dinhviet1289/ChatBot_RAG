# Copy file này thành .streamlit/secrets.toml khi chạy LOCAL (đừng commit secrets.toml).
# Trên Streamlit Cloud: dán nội dung này vào App settings -> Secrets.

GROQ_API_KEY = "key"

# Thêm key dự phòng: hết hạn mức mọi model của key này thì app tự sang key kế.
# Mỗi TÀI KHOẢN Groq có pool riêng (nhiều key trong cùng một tài khoản thì dùng chung pool).
# GROQ_API_KEYS = ["key_cua_ban_1", "key_cua_ban_2"]

# Rerank qua Cohere API (khuyên dùng trên cloud free — không tốn RAM):
# RERANK_PROVIDER = "cohere"    # off | cohere | local (local chỉ cho Colab/máy >2GB RAM)
# COHERE_API_KEY = "dan_cohere_trial_key_cua_m"
# RERANK_MODEL = "rerank-multilingual-v3.0"   # hoặc rerank-v3.5 / rerank-v4.0-fast

# Tuỳ chọn khác (bỏ comment nếu muốn đổi):
# LLM_MODEL = "qwen/qwen3.8-27b"     # mặc định. Key free chỉ gọi được 3 model,
#                                    # mỗi model có pool hạn mức riêng ~200K token/ngày
#                                    # (đổi sang model khác khi hết token):
#                                    # qwen/qwen3.8-27b, openai/gpt-oss-20b, openai/gpt-oss-120b
# RERANK_TOP_K = 5
# RETRIEVE_N = 20
# INDEX_PATH = "data/faiss_index_huggingface"
